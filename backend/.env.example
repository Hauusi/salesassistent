# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salesassistent

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379/0
MAIL_POLL_INTERVAL_SECONDS=60

# --- Token encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (Gmail API) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API, add an OAuth Client (type: Web application),
# and register GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# --- Anthropic Claude (classification, sentiment, draft generation) ---
ANTHROPIC_API_KEY=
# Draft generation (language quality matters).
ANTHROPIC_MODEL=claude-sonnet-5
# Classification (cheaper model, simple fixed-enum categorization task).
ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-4-5

# --- Voyage AI (embeddings for case/RAG matching, recommended by Anthropic) ---
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024

# --- Case matching heuristics (MVP defaults; see README for rationale) ---
CASE_SIMILARITY_THRESHOLD=0.78
CASE_LOOKBACK_DAYS=180

# --- Single-tenant MVP bootstrap ---
DEFAULT_TENANT_SLUG=default

# --- Contacts / follow-up (MVP default; see README for rationale) ---
CONTACT_FOLLOWUP_THRESHOLD_DAYS=5
